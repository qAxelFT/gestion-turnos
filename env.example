# Copia este archivo a .env y ajusta los valores. .env NO se sube a Git.
# Formato: CLAVE=valor, sin espacios alrededor del = y sin comillas.

# Base de datos (usuario de la aplicación, no el administrador)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestor_turnos
DB_USER=gestor_app
DB_PASSWORD=cambia-esta-contrasena

# Servidor
SERVER_PORT=8080
WORKERS=8
